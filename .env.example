# Sender API server — server-side only. NEVER prefix these with VITE_/NEXT_PUBLIC_.
# Copy to .env and fill with your own values. .env is git-ignored.

# Port for the sender server (default 8788)
PORT=8788

# Your deployed Apps Script Web App URL, ending in /exec (not /dev)
TABAH_EXEC_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Random URL-safe secret, 43-128 chars — must equal INGEST_SECRET in Script Properties.
# Generate two DIFFERENT secrets:  python -c "import secrets; print(secrets.token_urlsafe(48)); print(secrets.token_urlsafe(48))"
# The second one (ADMIN_SECRET) stays with the demo operator and is NOT used by this server.
TABAH_INGEST_SECRET=REPLACE_WITH_RANDOM_URLSAFE_SECRET_43_TO_128_CHARS

# Optional: comma-separated origin allowlist for browser calls, e.g. https://itqan.example
# Empty = same-origin only.
ALLOWED_ORIGINS=
